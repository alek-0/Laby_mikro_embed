#include "xparameters.h"
#include "xil_printf.h"
#include "xtmrctr.h"
#include "FreeRTOS.h"
#include "task.h"
#include <math.h>
#include <limits.h>

#define N_OF_TASKS 3
#define M_VALUE 1000000
#define Q_VALUE (3.14159265358979323846 / 2.0)

static TaskHandle_t xOneTaskHandle = NULL;
static TaskHandle_t xCountingTask = NULL;

XTmrCtr globTimerInstance;

int number_of_tasks = 3;

typedef struct {
    double result;
    int startIndex;
    int endIndex;
} ParamStr;

ParamStr taskData[N_OF_TASKS];

int tab[3] = {1,2,3};

// Print double with 8 digits precision
void printDouble8(double fval);


double CalculateRange(int start_count, int end_count) {
	xil_printf("In calcRagne start:%d end:%d\r\n",start_count, end_count);
    double sum = 0.0;
    for (int i = start_count; i <= end_count; i++) {
        sum += (sin(i * Q_VALUE)/i);
    }
    xil_printf("In calcRagne sum:");
    printDouble8(sum);
    xil_printf("\r\n");
    return sum;
}

void CountingTask(void *pvParameters){


	int n = (int)pvParameters;

	xil_printf("tasknumber: %d\r\n", n);
	xil_printf("task startIndex: %d\r\n", taskData[n-1].startIndex);
	xil_printf("task endIndex: %d\r\n", taskData[n-1].endIndex);
	int a = taskData[n-1].startIndex;
	int b = taskData[n-1].endIndex;
	xil_printf("task:%d | a=%d | b=%d \r\n",n,a,b);
	taskData[n-1].result = 0.0;
	taskData[n-1].result = CalculateRange(a,b);
	xil_printf("task result: ");
	printDouble8(taskData[n-1].result);
	xil_printf("\r\n");
	vTaskDelete(NULL);
}


void FreeRTOS_Calc(void *pvParameters) {
portTASK_USES_FLOATING_POINT();



for (int i=1; i<=number_of_tasks ; i++){
	xTaskCreate(CountingTask,
	    			"counting Task",
					configMINIMAL_STACK_SIZE * 4,
					(void *)tab[i-1],
					tskIDLE_PRIORITY + 1,
					&xCountingTask);
}

vTaskDelete(NULL);
}




int main(void)
{
    xil_printf("RTOS task comparison\r\n");


    //init timera
    int status = XTmrCtr_Initialize(&globTimerInstance, 0);
    if (status != XST_SUCCESS) {
            xil_printf("Timer initialization failed!\r\n");
            return -1;
        }
    XTmrCtr_SetOptions(&globTimerInstance, 0, XTC_AUTO_RELOAD_OPTION);

    XTmrCtr_Reset(&globTimerInstance, 0);
    XTmrCtr_Start(&globTimerInstance, 0);


    double wynik_0 = CalculateRange(1, M_VALUE);
    u32 t1 = XTmrCtr_GetValue(&globTimerInstance, 0);

    double seconds_0 = (double)t1 / (double)XPAR_TMRCTR_0_CLOCK_FREQ_HZ;

    xil_printf("Wynik obliczen bez taskow:");
    printDouble8(wynik_0);
    xil_printf("  Czas:");
    printDouble8(seconds_0);
    xil_printf("\r\n");
    // Koniec obliczen bez taskow






    int number_of_tasks = 3;
    xil_printf("Obliczanie zakresow takskow:\r\n");
    for(int i=0; i<number_of_tasks; i++) {
    	taskData[i].result = 0.0;
    	taskData[i].startIndex = i * M_VALUE/number_of_tasks + 1;
    	taskData[i].endIndex = (i+1) * M_VALUE/number_of_tasks;

    }


    xTaskCreate(FreeRTOS_Calc,
    			"MainCalc",
				configMINIMAL_STACK_SIZE * 4,
				NULL,
				tskIDLE_PRIORITY + 4,
				&xOneTaskHandle);
    vTaskStartScheduler();


    xil_printf("Print result z maina0:\r\n");
    printDouble8(taskData[0].result);
    xil_printf("Print result z maina1:\r\n");
    printDouble8(taskData[1].result);
    xil_printf("Print result z maina2:\r\n");
    printDouble8(taskData[2].result);

    return 0;
}


void printDouble8(double fval) {
    double fval2 = fval;
    int integerPart, fractionalPart;
    if (fval2 > INT32_MAX || fval2 <= INT32_MIN) {
        xil_printf("XXX.XXXXXXXX");
        return;
    }
    int sign = 0;
    if (fval2 < 0) sign = 1;
    fval2 = fabs(fval2);
    integerPart = (int)fval2;
    fractionalPart = (int)((fval2 - integerPart) * 100000000);
    if (sign) xil_printf("-");
    xil_printf("%d.%08d", integerPart, fractionalPart);
}


